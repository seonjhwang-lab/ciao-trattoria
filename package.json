{
  "name": "cozy-brunch-3d",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build && npm run build:artifact",
    "build:artifact": "node scripts/build-artifact.mjs && node scripts/check-emoji.mjs",
    "preview": "vite preview --host",
    "fetch-assets": "node scripts/fetch-assets.mjs",
    "check-emoji": "node scripts/check-emoji.mjs",
    "convert-mixamo": "esbuild scripts/mixamo/convert.src.js --bundle --platform=node --format=esm --outfile=node_modules/.cache/convert-mixamo.mjs --log-level=warning && node node_modules/.cache/convert-mixamo.mjs && node scripts/mixamo/optimize.mjs"
  },
  "dependencies": {
    "three": "^0.128.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "esbuild": "^0.28.2",
    "meshoptimizer": "^1.3.0",
    "vite": "^8.3.5"
  }
}
